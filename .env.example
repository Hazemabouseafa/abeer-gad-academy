# ==============================================================================
# ABEER GAD Academy (أكاديمية عبير جاد) - Environment Configuration Template
# ==============================================================================

# Database Connection (PostgreSQL - Neon / Supabase / Vercel Postgres)
# Transaction pooler URL (e.g. PgBouncer port 6543 for serverless environments)
DATABASE_URL="postgresql://postgres:password@localhost:5432/abeer_gad_academy?schema=public"
# Direct connection URL (port 5432) for running migrations and CLI tools
DIRECT_URL="postgresql://postgres:password@localhost:5432/abeer_gad_academy?schema=public"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:5001"

# Multi-Language Default Locale
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# PayPal REST API Integration
# Get these credentials from https://developer.paypal.com/dashboard/
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id_here"
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_secret_key_here"
# Set to 'sandbox' for testing, 'live' for production
PAYPAL_MODE="sandbox"
# Webhook ID created in PayPal Developer Dashboard to verify webhook signatures
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id_here"

# Admin & Session Security
# Generate secure keys via `openssl rand -hex 32`
ADMIN_SECRET_KEY="abeer_gad_academy_admin_secret_key_change_in_production"
SESSION_SECRET="abeer_gad_academy_session_secret_key_change_in_production"
NEXT_PUBLIC_ADMIN_EMAIL="admin@abeergadacademy.com"
